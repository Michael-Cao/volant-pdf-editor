<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>pdf_editor2</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.16.6" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
</Project>
