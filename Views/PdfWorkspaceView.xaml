<UserControl x:Class="pdf_editor2.Views.PdfWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:pdf_editor2.Behaviors"
             xmlns:local="clr-namespace:pdf_editor2.Views"
             xmlns:models="clr-namespace:pdf_editor2.Models"
             xmlns:converters="clr-namespace:pdf_editor2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Replaced PreviewKeyDown code-behind with clean XAML Input Bindings -->
    <UserControl.InputBindings>
        <KeyBinding Key="PageDown" Command="{Binding ScrollPageDownCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding ScrollPageUpCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer x:Name="WorkspaceScrollViewer" 
                  Background="#E5E5E5" 
                  ScrollChanged="WorkspaceScrollViewer_ScrollChanged"
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto">

        <ItemsControl ItemsSource="{Binding ActivePages}" Margin="20"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

            <ItemsControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
            </ItemsControl.LayoutTransform>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 🛠️ Attached behavior now takes care of RAM management cleanly -->
                    <Border Width="{Binding Width}" Height="{Binding Height}" Margin="0,10" Background="White" CornerRadius="2"
                            behaviors:PdfPageLifecycleBehavior.ObserveLifecycle="True">
                        <Grid>
                            <!-- MODE 1 -->
                            <Image Source="{Binding BackgroundImage}" Stretch="Uniform" 
                                   Visibility="{Binding DataContext.IsStructuredRenderingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <!-- MODE 2 -->
                            <Grid Visibility="{Binding DataContext.IsStructuredRenderingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <local:SkiaPdfTextSurface  
                                    WordsSource="{Binding WordsData}" 
                                    Width="{Binding Width}" 
                                    Height="{Binding Height}" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Top" 
                                    ClipToBounds="True">
                                </local:SkiaPdfTextSurface>
                            </Grid>

                            <TextBlock Text="Loading Page Vector Maps..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkGray" 
                                       Visibility="{Binding IsRendered, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
