<UserControl x:Class="pdf_editor2.Views.PdfWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdf_editor2.Views"
             xmlns:models="clr-namespace:pdf_editor2.Models"
             xmlns:converters="clr-namespace:pdf_editor2.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Resource bindings for routing visibility states -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Central Multi-Page View Container -->
    <ScrollViewer x:Name="WorkspaceScrollViewer" 
                  Grid.Column="1" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto" 
                  Background="#E5E5E5" 
                  ScrollChanged="WorkspaceScrollViewer_ScrollChanged">

        <ItemsControl x:Name="PagesControl" 
                      Margin="20"
                      ItemsSource="{Binding ActivePages}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.CacheLengthUnit="Item"
                      VirtualizingStackPanel.CacheLength="1,2">

            <ItemsControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
            </ItemsControl.LayoutTransform>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" 
                            Height="{Binding Height}" 
                            Margin="0,10,0,10" 
                            Background="White" 
                            CornerRadius="2"
                            Loaded="PageElement_Loaded" 
                            Unloaded="PageElement_Unloaded">
                        <Grid>
                            <!-- MODE 1: Flat Image Display (Visible when IsStructuredRenderingMode is FALSE) -->
                            <Image Source="{Binding BackgroundImage}" 
                                   Stretch="Uniform"
                                   Visibility="{Binding DataContext.IsStructuredRenderingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <!-- MODE 2: Structured Element Rendering (Visible when IsStructuredRenderingMode is TRUE) -->
                            <!-- 🚀 HIGH PERFORMANCE SWAP: Replaced the slow, nested ItemsControl tree loop with the drawing visual host surface -->
                            <Grid Visibility="{Binding DataContext.IsStructuredRenderingMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">

                                <!-- 🚀 HARMONIZED ZOOM & STRETCH: Passing the unscaled PageWidth and PageHeight constraints into the custom surface -->
                                <!-- forces the Viewbox to compare bounding boxes and uniformly magnify text elements into full paragraph blocks. -->
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                    <local:PdfTextSurface WordsSource="{Binding WordsData}"
                                                          Width="{Binding Width}" 
                                                          Height="{Binding Height}"
                                                          HorizontalAlignment="Left"                                                          
                                                          VerticalAlignment="Top"
                                                          ClipToBounds="True">
                                        <local:PdfTextSurface.LayoutTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="3.8" ScaleY="3.8"/>
                                            </TransformGroup>
                                        </local:PdfTextSurface.LayoutTransform>
                                    </local:PdfTextSurface>

                                </Viewbox>
                            </Grid>
                            
                            <!-- Placeholder Loading Indicator (Only shows when page is missing) -->
                            <TextBlock Text="Loading Page Vector Maps..." 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Foreground="DarkGray"
                                       Visibility="{Binding IsRendered, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
