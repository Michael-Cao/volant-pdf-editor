<UserControl x:Class="pdf_editor2.Views.PdfWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdf_editor2.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Central Multi-Page View Container -->
    <ScrollViewer x:Name="WorkspaceScrollViewer" 
                    Grid.Column="1" 
                    HorizontalScrollBarVisibility="Auto" 
                    VerticalScrollBarVisibility="Auto" 
                    Background="#E5E5E5" 
                    ScrollChanged="WorkspaceScrollViewer_ScrollChanged"
                    >

        <!-- 📁 FIXED: Attach the LayoutTransform directly onto the main PagesControl container -->
        <ItemsControl x:Name="PagesControl" 
                        Margin="20"
                        ItemsSource="{Binding ActivePages}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        VirtualizingStackPanel.CacheLengthUnit="Item"
                        VirtualizingStackPanel.CacheLength="1,2">

            <!-- Moving it here makes 'WorkspaceScaleTransform' globally visible to C# -->
            <ItemsControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
            </ItemsControl.LayoutTransform>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}" 
                    Height="{Binding Height}" 
                    Margin="0,10,0,10" 
                    Background="White" 
                    CornerRadius="2"
                    Loaded="PageElement_Loaded" 
                    Unloaded="PageElement_Unloaded">
                        <Grid>
                            <!-- Main Render Canvas -->
                            <Image Source="{Binding BackgroundImage}" Stretch="Uniform"/>

                            <!-- Placeholder Loading Indicator (Only shows when image is missing) -->
                            <TextBlock Text="Loading Page Vector Maps..." 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Foreground="DarkGray"
                                Visibility="{Binding IsRendered, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    
</UserControl>
