<Window x:Class="pdf_editor2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pdf_editor2"
        mc:Ignorable="d"
        Title="PDF Editor" Height="650" Width="900"
        WindowStartupLocation = "CenterScreen"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid Background="#F3F3F3">
        <!-- 1. DEFINE RIGID CELL SEPARATORS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Menu Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Action Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Main Workspace Canvas (Takes remaining space) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP WINDOWS MENU BAR -->
        <Menu Grid.Row="0" Background="#FFFFFF" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PDF..." Click="OpenPdf_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Close File" Click="ClosePdf_Click" InputGestureText="Ctrl+W"/>
                <Separator/>
                <MenuItem Header="_Save" Click="SavePdf_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..."/>
                <Separator/>
                <MenuItem Header="_Exit" Click="ExitApp_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_Help" Click="About_Click"/>
        </Menu>

        <!-- ROW 1: ACTION TOOLBAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="📁 Open PDF" Click="OpenPdf_Click" Width="100" Height="30" Margin="5,0" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="💾 Save As" Width="100" Height="30" Margin="5,0" Background="#E1E1E1" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ROW 2: MAIN WORKSPACE SPLIT (Enforces explicit boundaries inside Row 2) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- Sidebar Column -->
                <ColumnDefinition Width="*"/>
                <!-- Main Viewer Column -->
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Panel -->
            <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Document Properties" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtFilePath" Text="No file loaded" TextWrapping="Wrap" Foreground="#666666" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Central Multi-Page View Container -->
            <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Column="1" 
              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
              Background="#E5E5E5" ScrollChanged="WorkspaceScrollViewer_ScrollChanged">

                <!-- 📁 FIXED: Attach the LayoutTransform directly onto the main PagesControl container -->
                <ItemsControl x:Name="PagesControl" Margin="20"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">

                    <!-- Moving it here makes 'WorkspaceScaleTransform' globally visible to C# -->
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform x:Name="WorkspaceScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    </ItemsControl.LayoutTransform>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" Margin="0,15" CornerRadius="2" Width="{Binding Width}" Height="{Binding Height}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#BBBBBB" ShadowDepth="1"/>
                                </Border.Effect>
                                <Grid>
                                    <Image Source="{Binding BackgroundImage}" Stretch="Uniform"/>
                                    <ContentControl Content="{Binding ComponentCanvas}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ROW 3: BOTTOM WINDOWS STATUS BAR -->
        <StatusBar Grid.Row="3" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="5,3">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Expanded to 4 columns to fit the message, page label, slider, and percentage -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Column 0: Left message panel -->
                            <ColumnDefinition Width="120"/>
                            <!-- Column 1: Middle page tracker -->
                            <ColumnDefinition Width="220"/>
                            <!-- Column 2: NEW! Slider + adjustment buttons -->
                            <ColumnDefinition Width="70"/>
                            <!-- Column 3: Right zoom percentage label -->
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Pane 1: Message Pane (Left-aligned) -->
            <StatusBarItem Grid.Column="0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusMessage" Text="Ready" Foreground="#555555" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Pane 2: Page Pane (Column 1) -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10,0,10,0">
                    <TextBlock x:Name="TxtPageStatus" Text="Page 0 of 0" Foreground="#555555" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
            </StatusBarItem>

            <!-- 🔍 NEW Pane 3: Zoom Slider Control Group (Column 2) -->
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Center">
                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➖" Click="ZoomOut_Click" Width="24" Height="24" Background="#F0F0F0" BorderBrush="#CCCCCC" FontSize="10" VerticalAlignment="Center"/>
                        <Slider x:Name="ZoomSlider" Width="130" Minimum="0.5" Maximum="3.0" Value="1.0" 
                        TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"
                        ValueChanged="ZoomSlider_ValueChanged"/>
                        <Button Content="➕" Click="ZoomIn_Click" Width="24" Height="24" Background="#F0F0F0" BorderBrush="#CCCCCC" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StatusBarItem>

            <!-- Pane 4: Zoom Percentage Pane (Column 3) -->
            <StatusBarItem Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Border BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                    <TextBlock x:Name="TxtZoomStatus" Text="100%" Foreground="#555555" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Width="45" TextAlignment="Right"/>
                </Border>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
