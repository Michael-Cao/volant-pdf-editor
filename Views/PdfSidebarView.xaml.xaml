<UserControl x:Class="pdf_editor2.Views.PdfSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdf_editor2.Views"
             xmlns:sidviews="clr-namespace:pdf_editor2.Views.SideViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="250">
    <UserControl.Resources>
        <!-- Shared style for modern vertical sidebar toggle buttons -->
        <Style x:Key="SidebarToggleStyle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAEAEA"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <!-- Column 0: Left Vertical Toolbar -->
            <ColumnDefinition x:Name="ContentColumn" Width="*"/>
            <!-- Column 1: Collapsible Content Panel -->
        </Grid.ColumnDefinitions>

        <!-- COLUMN 0: PERMANENT LEFT VERTICAL TOOLBAR (Always Visible) -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,10,0,0">
                <!-- Navigation Tab Section -->
                <ToggleButton x:Name="BtnPages" Content="📄" Style="{StaticResource SidebarToggleStyle}" ToolTip="Pages" IsChecked="True" Checked="ToggleButton_Checked"/>
                <ToggleButton x:Name="BtnBookmarks" Content="🔖" Style="{StaticResource SidebarToggleStyle}" ToolTip="Bookmarks" Checked="ToggleButton_Checked"/>
                <ToggleButton x:Name="BtnAnnotations" Content="💬" Style="{StaticResource SidebarToggleStyle}" ToolTip="Annotations" Checked="ToggleButton_Checked"/>

                <!-- Divider between Navigation tabs and Workspace Rendering flags -->
                <Separator Height="1" Background="#E0E0E0" Margin="6,10,6,10" HorizontalAlignment="Stretch"/>

                <!-- Mode Switch Section: Binds to parent DataContext via Window/UserControl layout tree lookup -->
                <ToggleButton x:Name="BtnStructuredMode" 
                              Content="🔲" 
                              Style="{StaticResource SidebarToggleStyle}" 
                              ToolTip="Toggle Structured Element Rendering"
                              IsChecked="{Binding DataContext.IsStructuredRenderingMode, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </Border>

        <!-- COLUMN 1: COLLAPSIBLE SIDEBAR PANEL -->
        <Border x:Name="SidebarPanel" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch">
            <Grid Margin="10">

                <!-- 1. PAGES / BOM AREA -->
                <Grid x:Name="PagesContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Bind directly to the state of BtnPages to control visibility -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnPages}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <sidviews:ObjectInspectorView x:Name="ObjectInspectorPanel"/>
                </Grid>

                <!-- 2. BOOKMARKS AREA -->
                <Grid x:Name="BookmarksContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnBookmarks}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="Bookmarks/Outline Tree Content" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#888888"/>
                </Grid>

                <!-- 3. ANNOTATIONS AREA -->
                <Grid x:Name="AnnotationsContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnAnnotations}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Text="Annotations List Content" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#888888"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>

</UserControl>
