<UserControl x:Class="pdf_editor2.Views.SideViews.ObjectInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdf_editor2.Views.SideViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Section Title Header -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Scrollable Elements List Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Bottom Status Metrics Panel -->
        </Grid.RowDefinitions>

        <!-- 1. SECTION HEADER LAYOUT -->
        <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Object Inspector" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock x:Name="TxtPageSubTitle" Text="Visual elements extracted from current page" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. SCROLLABLE DATA GRID VIEW -->
        <!-- Changed ItemsSource path target directly to DisplayObjectsList -->
        <DataGrid x:Name="GridPageElements" 
          ItemsSource="{Binding DisplayObjectsList}"
          Grid.Row="1"
          AutoGenerateColumns="False" 
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#F0F0F0"
          Background="#FFFFFF"
          BorderThickness="1"
          BorderBrush="#D0D0D0"
          RowHeight="28"
          ColumnHeaderHeight="30"
          SelectionMode="Single"
          IsReadOnly="True"
          HeadersVisibility="Column">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="5,0"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>

                <DataGridTextColumn Header="IC" Binding="{Binding ElementId}" Width="35" IsReadOnly="True"/>

                <!-- Element type classification column (e.g. Text, Path, Image) -->
                <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="90" IsReadOnly="True"/>

                <!-- Content Details column: Maps directly to the 'Details' string property -->
                <DataGridTextColumn Header="Content" Binding="{Binding Details}" Width="*" MinWidth="100" IsReadOnly="True"/>

                <!-- Bounds layout coordinate column: Maps directly to 'BoundingBox' -->
                <DataGridTextColumn Header="Bounds" Binding="{Binding BoundingBox}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. BOTTOM METRICS SUMMARY STATUS LAYER -->
        <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,10,0,0" Padding="8">
            <Grid>
                <!-- Left structural description metadata string anchor -->
                <TextBlock Text="Total Page Elements:" FontSize="11" Foreground="#666666" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!-- Right reactive total item stream calculation display indicator -->
                <TextBlock Text="{Binding ExtractedObjects.Count, Mode=OneWay, StringFormat='{}{0} Objects'}" 
                           FontSize="11" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
