<UserControl x:Class="pdf_editor2.Views.SideViews.ObjectInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:side="clr-namespace:pdf_editor2.Views.SideViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 🛠️ Safe Relative Pack URI Pathing to avoid cross-assembly parsing conflicts -->
                <ResourceDictionary Source="ObjectInspectorTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Section Header -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Split View Workplace Area -->
        </Grid.RowDefinitions>

        <!-- 1. SECTION HEADER LAYOUT -->
        <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Object Inspector" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock x:Name="TxtPageSubTitle" Text="Visual elements extracted from current page" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. MAIN SPLIT SCREEN INTERFACE CONTAINER (STACKED VERTICALLY) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- 🛠️ CRITICAL LAYOUT MODIFICATION: Swapped out ColumnDefinitions for vertical RowDefinitions -->
                <RowDefinition Height="*"/>
                <!-- Top Pane: DataGrid List Grid -->
                <RowDefinition Height="Auto"/>
                <!-- Center: Horizontal Resizable Splitter Tracking line -->
                <RowDefinition Height="Auto"/>
                <!-- Bottom Pane: Detail View Sub-Panel Box (Controlled dynamically) -->
            </Grid.RowDefinitions>

            <!-- A: SCROLLABLE DATA GRID VIEW -->
            <DataGrid x:Name="GridPageElements" 
                      Grid.Row="0"
                      ItemsSource="{Binding ElementsList}"
                      SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                      SelectionChanged="GridPageElements_SelectionChanged"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      Background="#FFFFFF"
                      BorderThickness="1"
                      BorderBrush="#D0D0D0"
                      RowHeight="28"
                      ColumnHeaderHeight="30"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      HeadersVisibility="Column">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Foreground" Value="#555555"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="IC" Binding="{Binding ElementId}" Width="35" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="60" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Content" Width="*" MinWidth="80" 
                                            CellTemplate="{StaticResource DataGridContentCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- B: RESIZABLE GRID SPLITTER BAR (HORIZONTAL ORIENTATION) -->
            <!-- 🛠️ ORIENTATION PATCH: Modified properties to slide vertically instead of horizontally -->
            <GridSplitter x:Name="PanelSplitter"
                          Grid.Row="1" 
                          Height="4" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Center" 
                          Background="#EAEAEA"
                          ShowsPreview="True"
                          Visibility="Collapsed"/>

            <!-- C: MODULARIZED DETAIL PANEL SUB-VIEW INTERFACE -->
            <!-- 🛠️ RESPONSIVE FIT PATCH: Removed hardcoded Width="260" and swapped it for adaptive Height constraints -->
            <side:ObjectElementDetailView x:Name="DetailPanel"
                              Grid.Row="2" 
                              MinHeight="140"
                              Width="Auto" 
                              Margin="0,8,0,0"
                              Visibility="Collapsed"/>
        </Grid>
    </Grid>

</UserControl>
