<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <DataTemplate x:Key="SpatialBoundariesSection">
        <!-- 1. Use an Expander as the root wrapper -->
        <Expander IsExpanded="True" 
             Margin="0,0,0,6"
             HorizontalContentAlignment="Stretch">

            <!-- 2. Move your Header style and text right into the Expander's header -->
            <Expander.Header>
                <TextBlock Text="Spatial Boundaries" 
                           Style="{DynamicResource HeaderStyle}"
                           Margin="4,0,0,0" 
                           VerticalAlignment="Center"/>
            </Expander.Header>

            <!-- 3. Your content panel goes inside the body of the Expander -->
            <StackPanel Margin="0,6,0,4">
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,2">
                        <TextBlock Text="X Coordinate" Style="{DynamicResource SubTitleStyle}"/>
                        <TextBlock Style="{DynamicResource SubValueStyle}">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="Model.X" StringFormat="{}{0:F2} pt"/>
                                    <Binding Path="X" StringFormat="{}{0:F2} pt"/>
                                    <Binding Source="N/A"/>
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="Y Coordinate" Style="{DynamicResource SubTitleStyle}"/>
                        <TextBlock Style="{DynamicResource SubValueStyle}">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="Model.Y" StringFormat="{}{0:F2} pt"/>
                                    <Binding Path="Y" StringFormat="{}{0:F2} pt"/>
                                    <Binding Source="N/A"/>
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="Width Size" Style="{DynamicResource SubTitleStyle}"/>
                        <TextBlock Style="{DynamicResource SubValueStyle}">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="Model.Width" StringFormat="{}{0:F2} pt"/>
                                    <Binding Path="Width" StringFormat="{}{0:F2} pt"/>
                                    <Binding Source="N/A"/>
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="Height Size" Style="{DynamicResource SubTitleStyle}"/>
                        <TextBlock Style="{DynamicResource SubValueStyle}">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="Model.Height" StringFormat="{}{0:F2} pt"/>
                                    <Binding Path="Height" StringFormat="{}{0:F2} pt"/>
                                    <Binding Source="N/A"/>
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Expander>
    </DataTemplate>

</ResourceDictionary>