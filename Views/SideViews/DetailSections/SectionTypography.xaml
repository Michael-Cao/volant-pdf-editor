<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TypographySection">
        <!-- 1. Use an Expander as the root wrapper -->
        <Expander IsExpanded="True" 
                  Margin="0,0,0,6"
                  HorizontalContentAlignment="Stretch">

            <!-- 2. Move your Header style and text right into the Expander's header -->
            <Expander.Header>
                <TextBlock Text="Typography &amp; Aesthetics" 
                           Style="{DynamicResource HeaderStyle}" 
                           Margin="4,0,0,0" 
                           VerticalAlignment="Center"/>
            </Expander.Header>

            <!-- 3. Your content panel goes inside the body of the Expander -->
            <StackPanel Margin="0,6,0,4">
                <!-- Left margin indentation looks cleaner when expanded -->
                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,2">
                        <TextBlock Text="Font Weight Size" Style="{DynamicResource SubTitleStyle}"/>
                        <TextBlock Style="{DynamicResource SubValueStyle}">
                            <TextBlock.Text>
                                <PriorityBinding>
                                    <Binding Path="Model.FontSize" StringFormat="{}{0:F1} pt"/>
                                    <Binding Path="FontSize" StringFormat="{}{0:F1} pt"/>
                                    <Binding Source="N/A"/>
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="Color Channel Hex" Style="{DynamicResource SubTitleStyle}"/>
                        <Border HorizontalAlignment="Left" Margin="0,2,0,0" CornerRadius="2" Padding="4,1" BorderThickness="1" BorderBrush="#E0E0E0">
                            <TextBlock FontSize="11" FontFamily="Consolas" Foreground="#333333" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <PriorityBinding>
                                        <Binding Path="Model.ForegroundColor"/>
                                        <Binding Path="ForegroundColor"/>
                                        <Binding Source="#000000"/>
                                    </PriorityBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Font Family Name" Style="{DynamicResource SubTitleStyle}"/>
                    <TextBlock Style="{DynamicResource SubValueStyle}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <PriorityBinding>
                                <Binding Path="Model.StyleMetrics.FontName"/>
                                <Binding Path="StyleMetrics.FontName"/>
                                <Binding Source="Standard System Font"/>
                            </PriorityBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Expander>
    </DataTemplate>

</ResourceDictionary>
