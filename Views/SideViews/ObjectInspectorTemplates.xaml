<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:side="clr-namespace:pdf_editor2.Views.SideViews"
                    x:Class="pdf_editor2.Views.SideViews.ObjectInspectorTemplates">

    <!-- Content Column CellTemplate Configuration -->
    <DataTemplate x:Key="DataGridContentCellTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Truncated preview text block segment -->
            <TextBlock Grid.Column="0" 
                       Text="{Binding Details, Mode=OneWay}" 
                       TextTrimming="CharacterEllipsis" 
                       Foreground="#333333" 
                       Margin="5,0"
                       VerticalAlignment="Center"/>

            <!-- Inline inspector button -->
            <Button Grid.Column="1" 
                    x:Name="BtnInspectText"
                    Content="..." 
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="#666666"
                    Width="22" 
                    Height="18" 
                    Margin="4,0"
                    Padding="0,0,0,3"
                    Background="#F5F5F5" 
                    BorderBrush="#DCDCDC"
                    BorderThickness="1" 
                    Cursor="Hand"
                    ToolTip="Inspect Full Paragraph Text"
                    Click="BtnInspectText_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementType}" Value="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Widened popup insight panel overlay -->
            <Popup x:Name="TextDetailPopup" 
                   PlacementTarget="{Binding ElementName=BtnInspectText}" 
                   Placement="Left" 
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#FFFFFF" 
                        BorderBrush="#007ACC" 
                        BorderThickness="1.5" 
                        CornerRadius="5" 
                        Padding="14" 
                        Width="500" 
                        MaxHeight="380"
                        Margin="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="#AAAAAA" ShadowDepth="4" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Full Paragraph Content" FontSize="12" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,8"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding Details, Mode=OneWay}" 
                                       TextWrapping="Wrap" 
                                       FontSize="12" 
                                       LineHeight="18"
                                       Foreground="#222222"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>

</ResourceDictionary>