<UserControl x:Class="pdf_editor2.Views.SideViews.ObjectElementDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdf_editor2.Views.SideViews"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/SideViews/DetailSections/SectionSpatial.xaml" />
                <ResourceDictionary Source="/Views/SideViews/DetailSections/SectionTypography.xaml" />
                <ResourceDictionary Source="/Views/SideViews/DetailSections/SectionContent.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
            <!-- Reusable Style Presets for clear tracking parameters -->
            <Style x:Key="SubTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#888888"/>
            </Style>
            <Style x:Key="SubValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#222222"/>
            </Style>
            <Style x:Key="HeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12,12,0,12" VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">

                <!-- Fallback empty prompt overlay -->
                <TextBlock Text="Select an element to view detailed properties." Foreground="#999999" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,40,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Properties inspector main presentation tree matrix -->
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 
                    <TextBlock Text="Element Properties" FontSize="12" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>
                    -->

                    <!-- SECTION 1: SPATIAL BOUNDARIES -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SpatialBoundariesSection}"/>
                  
                    <Separator Background="#EAEAEA" Margin="0,0,0,12"/>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TypographySection}"/>

                    <Separator Background="#EAEAEA" Margin="0,0,0,12"/>

                    <!-- SECTION 3: RAW TEXT STRINGS PREVIEW -->
                    <TextBlock Text="Raw Object Content" Style="{StaticResource HeaderStyle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#444444" Block.LineHeight="16" LineStackingStrategy="BlockLineHeight">
                        <TextBlock.Text>
                            <PriorityBinding>
                                <Binding Path="Details" Mode="OneWay"/>
                                <Binding Path="Text" Mode="OneWay"/>
                                <Binding Path="Model.Text" Mode="OneWay"/>
                                <Binding Source="No content available."/>
                            </PriorityBinding>
                        </TextBlock.Text>
                    </TextBlock>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>

</UserControl>
